#!/bin/bash
# ==============================================================
# 大清天朵二期社區 AI 管理助手 - macOS 雙擊啟動檔 (start.command)
# 在 macOS 訪達 (Finder) 中直接雙擊此檔案即可啟動並開啟瀏覽器
# ==============================================================

# 切換至本腳本所在目錄
cd "$(dirname "$0")"

echo "=========================================================="
echo "  大清天朵二期社區 AI 管理助手 - 本地系統啟動中..."
echo "=========================================================="
echo "1. 正在檢查 Python 3 環境..."

if ! command -v python3 &> /dev/null; then
    echo "❌ 錯誤：未偵測到 Python 3，請先安裝 Python 3！"
    echo "按任意鍵離開..."
    read -n 1
    exit 1
fi

echo "✅ Python 3 就緒！"
echo "2. 正在啟動社區 AI 助手後端服務 (Port: 8080)..."

# 啟動 server.py
python3 server.py &
SERVER_PID=$!

# 等待 1 秒後開啟預設瀏覽器
sleep 1
echo "3. 正在開啟瀏覽器前往: http://127.0.0.1:8080"
open "http://127.0.0.1:8080"

echo ""
echo "=========================================================="
echo "  系統已順利啟動！請在瀏覽器中操作社區 AI 助手。"
echo "  若要停止服務，請直接關閉此終端機視窗或按 Ctrl+C。"
echo "=========================================================="

# 等待背景程序結束
wait $SERVER_PID
